# Токен вашего Discord бота
# Получите его на https://discord.com/developers/applications -> Ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=ВАШ_ТОКЕН_ЗДЕСЬ

# Имя файла базы данных (по умолчанию bot_database.db в папке бота)
DATABASE_PATH=bot_database.db

# Префикс для автоматически генерируемых кодов
CODE_PREFIX=ROLE
